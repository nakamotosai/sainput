# ─────────────────────────────────────────────────────────────
# sainput .gitignore
# 原则：个人配置、运行时产物、模型、内部文档都不进仓库；
#      可公开的模板以同名 *.example 提交（见 CONTRIBUTING.md）。
# ─────────────────────────────────────────────────────────────

# ── Rust 构建产物 ──
/target
/target-test
# 任何新命名的 target 目录都不许进仓库(2026-10-31 踩过:新建 target-t14b 被 git add -A 扫进去,
# 58MB 的 rlib 直接推上了远端 —— .gitignore 只认老名字等于没拦)
/target-*

# ── 个人配置与运行时状态（提交同名 .example，不提交真实文件）──
/sainput.conf
/hotwords.txt
/.ctx_hotwords.txt
/@AutomationLog.txt
/latency.txt

# ── 模型与日志 ──
# models 下的模型文件是大体积二进制；但 models/README.md 要提交，
# 所以先放行目录本身，再排除内容，最后放行 README。
/models
!/models/
/models/*
!/models/README.md
# 会话日志逐条记录了用户说出的原文，绝不入库。
/logs

# ── 本机工具链覆盖（因机器而异，提交 .example）──
/.cargo/config.toml
/rust-toolchain.toml

# ── 内部文档（本地保留，不公开）──
/HANDOFF.md
/PLAN.md
/FROZEN.md
/FROZEN-v0.2.1.md
/FROZEN-v0.2.2.md
/FROZEN-v0.2.4.md

# ── 本地工作目录 ──
/archive/
/.tools/
/tmp/

# ── Python ──
**/__pycache__/
*.pyc

# ── 本机语音栈的私钥 / 证书(绝不入库;证书由 tools/make_certs.py 现生成)──
/tools/*.key
/tools/*.pem

# ── 音频与临时文件 ──
*.wav
*.pcm
*.tar.bz2
*.bak
*.bak-*
*~

# release artifacts (packaging pipeline)
dist/
.runtime-src/
/FROZEN-v0.2.5.md
/FROZEN-v0.2.6.md
