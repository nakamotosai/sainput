diff --git a/nebula_app/src/gpui_shell/terminal/view/runtime.rs b/nebula_app/src/gpui_shell/terminal/view/runtime.rs
index 3dec1ac..cd04627 100644
--- a/nebula_app/src/gpui_shell/terminal/view/runtime.rs
+++ b/nebula_app/src/gpui_shell/terminal/view/runtime.rs
@@ -674,6 +674,65 @@ impl TerminalView {
         Ok(())
     }
 
+    /// `pane.compose`:把文本放进**组合态缓冲层**(与输入法 preedit 同一条渲染
+    /// 路径),完全不碰 PTY;`commit` 时清掉缓冲层,把整段作为**一次**写入交给 PTY。
+    ///
+    /// 为什么要有这个东西:听写/ASR 的一句话在说完之前一直在被改写(实测语料里
+    /// 约 5% 的帧会回头改前面的词)。逐字上屏 + 退格补打能把结果修对,但中间态是
+    /// 真实的按键副作用,而且每一次改写都在和应用的输入栈博弈。组合串把中间态放在
+    /// **应用自己的 preedit** 里:改写零成本、零副作用,屏幕上永远不会出现半句被改
+    /// 残的文本;定稿只写一次 PTY。
+    ///
+    /// 语义边界:
+    /// - 空 `text` + `commit=false` = 取消组合(与 IME 清除同义);
+    /// - 组合态期间该 pane 的按键处理会让位给组合串(与输入法组合态一致),
+    ///   所以调用方必须负责提交或取消,不能把组合串挂在那里不管;
+    /// - 本地内容同样不得自动流向 SSH 目标(`ensure_local_context_allowed`)。
+    pub fn runtime_compose(
+        &mut self,
+        text: String,
+        commit: bool,
+        origin: InputOrigin,
+        cx: &mut Context<Self>,
+    ) -> Result<(), crate::runtime_api::ApiError> {
+        self.ensure_local_context_allowed(origin)?;
+        if let Some(reason) = &self.exited {
+            return Err(crate::runtime_api::ApiError::new(
+                "invalid_state",
+                format!("pane has exited: {reason}"),
+            ));
+        }
+        if self.answer_reader.is_some() {
+            return Err(crate::runtime_api::ApiError::new(
+                "invalid_state",
+                "pane is showing a question panel",
+            ));
+        }
+        self.ensure_runtime_readable()?;
+        if self.session.is_none() {
+            return Err(crate::runtime_api::ApiError::new(
+                "runtime_unavailable",
+                "terminal session is unavailable for this pane",
+            ));
+        }
+
+        if commit {
+            // 与输入法的 GCS_RESULTSTR 同一条路:先清组合串,再一次性写入。
+            self.marked_text = None;
+            if !text.is_empty() {
+                if !self.term_mode().contains(TermMode::ALT_SCREEN) {
+                    crate::display::nebula_input_text(&mut self.suggest, &text);
+                }
+                self.write_user_text(text.clone(), false, text.as_bytes().to_vec(), cx);
+            }
+        } else {
+            self.marked_text = if text.is_empty() { None } else { Some(text) };
+        }
+        self.restart_cursor_blink(cx);
+        cx.notify();
+        Ok(())
+    }
+
     /// 三层护栏里唯一强制的那一层。
     ///
     /// 另两层都能被绕过，所以都只是护栏：第一层是便利层，Send-to-Chat 的目标
