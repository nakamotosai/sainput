diff --git a/scripts/conformance/cases/compose.py b/scripts/conformance/cases/compose.py
new file mode 100644
index 0000000..0a9c91a
--- /dev/null
+++ b/scripts/conformance/cases/compose.py
@@ -0,0 +1,80 @@
+"""`pane.compose`:组合态缓冲层 —— 输入驱动用的一条路。
+
+断言的是这条路的**合同**,不是它的实现:
+  1. `runtime.describe` 声明了方法与特性(旧版本据此回落,而不是猜);
+  2. 组合态期间**一个字节都不进 PTY**(读真实 Grid 验证),可以反复整体改写;
+  3. `commit` 时整段作为**一次**写入进 Grid(不许出现两遍);
+  4. 空串 + 不提交 = 取消:Grid 里不留任何痕迹;
+  5. 字节边界与 `pane.paste` 一致:控制序列被拒,且拒绝之后 Grid 仍然干净。
+"""
+
+from __future__ import annotations
+
+import time
+
+from conformance.harness import ApiFailure, ConformanceContext, require
+
+
+def run(ctx: ConformanceContext) -> dict[str, object]:
+    capabilities = set(ctx.description.get("capabilities") or [])
+    require("pane.compose" in capabilities, "runtime.describe omits pane.compose")
+    features = set(ctx.description.get("features") or [])
+    require("pane.compose.buffer" in features, "runtime.describe omits pane.compose.buffer")
+
+    ctx.refresh_targets()
+    first = "NEBULA_COMPOSE_ALPHA"
+    revised = "NEBULA_COMPOSE_ALPHA_REVISED"
+
+    # 组合态:整句只进缓冲层。它渲染在光标处,但**不进 Grid** —— Grid 里的东西
+    # 已经交给 PTY 了,那正是这条路要避开的中间态。
+    ctx.compose(first)
+    time.sleep(0.3)
+    require(first not in ctx.read(lines=40)["text"], "composition reached the terminal grid before commit")
+
+    # 改写是整体替换:输入驱动每帧都这么干(真机语料里约 5% 的帧会回头改前面的词)。
+    ctx.compose(revised)
+    time.sleep(0.3)
+    grid = ctx.read(lines=40)["text"]
+    require(
+        revised not in grid and first not in grid,
+        "rewriting the composition leaked into the terminal grid",
+    )
+
+    # 取消:不留痕迹。
+    ctx.compose("")
+    time.sleep(0.2)
+    require(revised not in ctx.read(lines=40)["text"], "cancel left text behind")
+
+    # 提交:整段一次进 Grid,而且只出现一次。
+    ctx.compose(revised, commit=True)
+    read = ctx.poll(
+        lambda: ctx.read(lines=40),
+        lambda value: revised in value["text"],
+        "committed composition never reached the terminal grid",
+    )
+    require(
+        read["text"].count(revised) == 1,
+        f"committed composition was written {read['text'].count(revised)} times",
+    )
+
+    # 组合串不是字节注入旁路:控制序列必须被拒,且拒绝之后 Grid 仍然干净。
+    rejected = False
+    try:
+        ctx.compose("unsafe\u001b[201~tail", commit=True)
+    except ApiFailure as error:
+        rejected = error.error.get("code") == "invalid_params"
+    require(rejected, "pane.compose accepted a terminal control sequence")
+    require(
+        "unsafe" not in ctx.read(lines=40)["text"],
+        "rejected composition still reached the terminal grid",
+    )
+
+    ctx.send_key("c", control=True)
+    return {
+        "composition_stays_off_grid": True,
+        "rewrite_is_free": True,
+        "commit_is_single_write": True,
+        "cancel_leaves_nothing": True,
+        "byte_boundary_enforced": True,
+        "coverage": "runtime_compose_buffer",
+    }
